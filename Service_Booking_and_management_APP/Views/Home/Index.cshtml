@{
    ViewData["Title"] = "Home Page";
}
<style>
    .auth-page{padding:0px !important}
</style>

<main class="welcome-shell">
    <div class="welcome-glow glow-one"></div><div class="welcome-glow glow-two"></div>
    <header class="welcome-top">
        <a class="brand brand-light" href="~/registration" aria-label="Service Booking home">
            <span class="brand-mark"><i class="bi bi-house-gear-fill"></i></span>
            <span class="brand-copy"><strong>Service<span>ly</span></strong><small>HOME SERVICES</small></span>
        </a>
        <span class="secure-pill"><i class="bi bi-shield-check"></i> Trusted at home</span>
    </header>
    <section class="welcome-content">
        <div class="welcome-copy">
            <span class="eyebrow eyebrow-light"><span class="eyebrow-dot"></span> YOUR HOME, IN GOOD HANDS</span>
            <h1>Great service.<br><span>Right at your</span> doorstep.</h1>
            <p class="welcome-description">Book trusted professionals for all your home service needs. Easy booking, reliable experts, and more time for what matters.</p>
            <div class="welcome-benefits">
                <div><span class="benefit-icon"><i class="bi bi-patch-check-fill"></i></span><span><b>Verified professionals</b><small>People you can trust</small></span></div>
                <div><span class="benefit-icon"><i class="bi bi-clock-fill"></i></span><span><b>Booking made easy</b><small>At a time that suits you</small></span></div>
            </div>
        </div>
        <div class="home-visual" aria-label="Illustration of a comfortable living room">
            <div class="visual-orbit orbit-a"></div><div class="visual-orbit orbit-b"></div>
            <div class="floating-bubble bubble-tool"><i class="bi bi-tools"></i></div>
            <div class="floating-bubble bubble-spark"><i class="bi bi-stars"></i></div>
            <div class="room-window"><span></span><span></span><span></span></div>
            <div class="plant plant-left"><i class="bi bi-flower1"></i></div>
            <div class="floor"></div>
            <div class="sofa">
                <div class="sofa-back"></div><div class="sofa-seat"></div>
                <div class="sofa-arm arm-left"></div><div class="sofa-arm arm-right"></div>
                <div class="sofa-cushion cushion-one"></div><div class="sofa-cushion cushion-two"></div>
                <div class="sofa-leg leg-left"></div><div class="sofa-leg leg-right"></div>
            </div>
            <div class="side-table"><div class="table-top"></div><div class="table-leg"></div><div class="table-vase"><i class="bi bi-flower2"></i></div></div>
            <div class="plant plant-right"><i class="bi bi-flower1"></i></div>
            <div class="visual-caption"><span class="caption-check"><i class="bi bi-check-lg"></i></span><span><b>Your home, taken care of</b><small>Quality service, every time</small></span><i class="bi bi-arrow-up-right ms-auto"></i></div>
        </div>
    </section>

    <footer class="welcome-footer">
        <div class="footer-note"><i class="bi bi-heart-fill"></i> Making home care feel effortless</div>
        <div class="welcome-actions">
            <a class="btn btn-welcome-primary" href="~/registration">Get Started <i class="bi bi-arrow-right"></i></a>
            <p>Already have an account? <a href="~/login">Login</a></p>
        </div>
    </footer>
</main>