<main class="auth-shell">
    <a class="back-link" href="~/login" aria-label="Back to login"><i class="bi bi-arrow-left"></i></a>
    <div class="auth-brand brand"><span class="brand-mark"><i class="bi bi-house-gear-fill"></i></span><span class="brand-copy"><strong>Service<span>ly</span></strong><small>HOME SERVICES</small></span></div>
    <section class="auth-card recovery-card">
        <div class="recovery-illustration"><div class="lock-halo"></div><div class="lock-icon"><i class="bi bi-shield-lock-fill"></i></div><span class="lock-spark spark-a"><i class="bi bi-stars"></i></span><span class="lock-spark spark-b"><i class="bi bi-shield-check"></i></span></div>
        <div class="auth-heading text-center">
            <span class="eyebrow"><span class="eyebrow-dot"></span> ACCOUNT RECOVERY</span>
            <h1>Reset Your Password</h1>
            <p>Enter your email address and we'll help you get back into your account with a verification code.</p>
        </div>
        <form id="forgotForm" novalidate>
            <div class="field-group">
                <label for="forgotEmail">Email Address</label>
                <div class="input-wrap"><i class="bi bi-envelope"></i><input id="forgotEmail" name="email" type="email" autocomplete="email" placeholder="aman@gmail.com" required></div>
                <div class="invalid-feedback">Please enter a valid email address.</div>
            </div>
            <div class="form-alert" id="forgotAlert" role="alert" hidden></div>
            <button class="btn btn-gradient w-100" type="submit">Send OTP <i class="bi bi-arrow-right"></i></button>
        </form>
        <a class="back-to-login" href="~/login"><i class="bi bi-arrow-left"></i> Back to Login</a>
        <p class="recovery-demo-note"><i class="bi bi-info-circle"></i> Demo only — no email or OTP is sent yet. Brevo integration will be added here.</p>
    </section>
    <div class="auth-bottom-note"><i class="bi bi-shield-lock"></i> We'll help you get back in securely</div>
</main>
