    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
<main class="auth-shell">
    <a class="back-link" href="~/splash" aria-label="Back to welcome page"><i class="bi bi-arrow-left"></i></a>
    <div class="auth-brand brand">
        <span class="brand-mark"><i class="bi bi-house-gear-fill"></i></span>
        <span class="brand-copy"><strong>Service<span>ly</span></strong><small>HOME SERVICES</small></span>
    </div>
    <section class="auth-card register-card">
        <div class="auth-heading">
            <span class="eyebrow"><span class="eyebrow-dot"></span> LET'S GET YOU STARTED</span>
            <h1>Create Account</h1>
            <p>Join us and get your services done easily.</p>
        </div>
        <form id="registerForm" novalidate>
            <div class="field-group">
                <label for="fullName">Full Name</label>
                <div class="input-wrap"><i class="bi bi-person"></i><input id="fullName" name="fullName" type="text" autocomplete="name" placeholder="Enter your full name" required minlength="2"><span class="field-status"><i class="bi bi-check-circle-fill"></i></span></div>
                <div class="invalid-feedback">Please enter your full name (at least 2 characters).</div>
            </div>
            <div class="field-group">
                <label for="email">Email Address</label>
                <div class="input-wrap"><i class="bi bi-envelope"></i><input id="email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required><span class="field-status"><i class="bi bi-check-circle-fill"></i></span></div>
                <div class="invalid-feedback">Enter a valid email address.</div>
            </div>
            <div class="field-group">
                <label for="phone">Phone Number <span class="label-optional">Optional</span></label>
                <div class="input-wrap"><i class="bi bi-telephone"></i><input id="phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="+91 98765 43210" pattern="^[0-9+()\\s-]{7,20}$"><span class="field-status"><i class="bi bi-check-circle-fill"></i></span></div>
                <div class="invalid-feedback">Enter a valid phone number.</div>
            </div>
            <div class="field-group">
                <label for="password">Password</label>
                <div class="input-wrap"><i class="bi bi-lock"></i><input id="password" name="password" type="password" autocomplete="new-password" placeholder="Create a strong password" required minlength="8" aria-describedby="passwordHelp"><button class="password-toggle" type="button" data-toggle-password="password" aria-label="Show password"><i class="bi bi-eye"></i></button></div>
                <div class="password-strength" aria-live="polite"><span class="strength-track"><span id="strengthFill"></span></span><small id="passwordHelp">Use 8+ characters with a number or symbol.</small></div>
                <div class="invalid-feedback">Use at least 8 characters.</div>
            </div>
            <div class="field-group">
                <label for="confirmPassword">Confirm Password</label>
                <div class="input-wrap"><i class="bi bi-shield-lock"></i><input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" placeholder="Re-enter your password" required><button class="password-toggle" type="button" data-toggle-password="confirmPassword" aria-label="Show confirm password"><i class="bi bi-eye"></i></button></div>
                <div class="invalid-feedback">Passwords must match.</div>
            </div>
            <div class="form-check terms-check">
                <input class="form-check-input" type="checkbox" id="terms" required>
                <label class="form-check-label" for="terms">I agree to the <a href="#" data-policy-placeholder>Terms &amp; Conditions</a> and <a href="#" data-policy-placeholder>Privacy Policy</a>.</label>
                <div class="invalid-feedback">Please accept the terms to continue.</div>
            </div>
            <div class="form-alert" id="registerAlert" role="alert" hidden></div>
            <button class="btn btn-gradient w-100" type="submit">Register <i class="bi bi-arrow-right"></i></button>
        </form>
        <p class="auth-switch">Already have an account? <a href="~/login">Login</a></p>
        <p class="integration-note"><i class="bi bi-info-circle"></i> Demo UI only — connect your ASP.NET Core API to create accounts and send OTPs.</p>
    </section>
    <div class="auth-bottom-note"><i class="bi bi-shield-check"></i> Your details are kept secure</div>
</main>