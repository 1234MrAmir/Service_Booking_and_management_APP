<main class="auth-shell">
    <a class="back-link" href="~/forgot-password" aria-label="Back to forgot password"><i class="bi bi-arrow-left"></i></a>
    <div class="auth-brand brand"><span class="brand-mark"><i class="bi bi-house-gear-fill"></i></span><span class="brand-copy"><strong>Service<span>ly</span></strong><small>HOME SERVICES</small></span></div>
    <section class="auth-card recovery-card reset-card">
        <div class="recovery-illustration"><div class="lock-halo"></div><div class="lock-icon"><i class="bi bi-lock"></i></div><span class="lock-spark spark-a"><i class="bi bi-stars"></i></span><span class="lock-spark spark-b"><i class="bi bi-shield-check"></i></span></div>
        <div class="auth-heading text-center">
            <span class="eyebrow"><span class="eyebrow-dot"></span> CREATE A NEW KEY</span>
            <h1>Enter New Password</h1>
            <p>Your new password must be different from previously used passwords.</p>
        </div>
        <form id="resetForm" novalidate>
            <div class="field-group">
                <label for="newPassword">New Password</label>
                <div class="input-wrap"><i class="bi bi-lock"></i><input id="newPassword" name="newPassword" type="password" autocomplete="new-password" placeholder="Enter new password" required minlength="8"><button class="password-toggle" type="button" data-toggle-password="newPassword" aria-label="Show new password"><i class="bi bi-eye"></i></button></div>
                <div class="password-strength"><span class="strength-track"><span id="resetStrengthFill"></span></span><small id="resetPasswordHelp">Use at least 8 characters.</small></div>
                <div class="invalid-feedback">Use at least 8 characters.</div>
            </div>
            <div class="field-group">
                <label for="confirmNewPassword">Confirm Password</label>
                <div class="input-wrap"><i class="bi bi-shield-lock"></i><input id="confirmNewPassword" name="confirmNewPassword" type="password" autocomplete="new-password" placeholder="Confirm new password" required><button class="password-toggle" type="button" data-toggle-password="confirmNewPassword" aria-label="Show confirm password"><i class="bi bi-eye"></i></button></div>
                <div class="invalid-feedback">Passwords must match.</div>
            </div>
            <div class="form-alert" id="resetAlert" role="alert" hidden></div>
            <button class="btn btn-gradient w-100" type="submit">Reset Password <i class="bi bi-arrow-right"></i></button>
        </form>
        <a class="back-to-login" href="~/login"><i class="bi bi-arrow-left"></i> Back to Login</a>
        <p class="recovery-demo-note"><i class="bi bi-info-circle"></i> Demo only — the password won't be changed until your API is connected.</p>
    </section>
    <div class="auth-bottom-note"><i class="bi bi-shield-check"></i> Keep your account protected</div>
</main>
